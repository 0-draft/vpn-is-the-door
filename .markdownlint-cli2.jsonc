{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD033": { "allowed_elements": ["picture", "source", "img"] },
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    "playwright-report/**",
    "test-results/**",
    ".playwright-mcp/**"
  ]
}
