---
// Site search: a native <dialog> palette over the Pagefind index that
// `pagefind --site dist` writes after the build (package.json postbuild).
// The index exists only in the built site, so under `astro dev` the palette
// opens and says so instead of failing.
import { t } from "../../i18n/ui";
import type { Lang } from "../../lib/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = {
  hint: t(lang, "search.hint"),
  empty: t(lang, "search.empty"),
  unavailable: t(lang, "search.unavailable"),
  count1: t(lang, "search.count1"),
  countN: t(lang, "search.countN"),
  kinds: {
    summary: t(lang, "search.kind.summary"),
    chapter: t(lang, "search.kind.chapter"),
    case: t(lang, "search.kind.case"),
    glossary: t(lang, "search.kind.glossary"),
    sources: t(lang, "search.kind.sources"),
  },
};
---

<dialog
  class="search"
  data-search
  aria-label={t(lang, "search.label")}
  data-lang={lang}
  data-base={import.meta.env.BASE_URL}
  data-strings={JSON.stringify(strings)}
>
  <div class="search-head">
    <svg class="search-glass" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="10" cy="10" r="6.5"></circle>
      <path d="M15 15 L21 21"></path>
    </svg>
    <input
      type="search"
      data-search-input
      role="combobox"
      aria-expanded="false"
      aria-autocomplete="list"
      aria-controls="search-results"
      aria-label={t(lang, "search.placeholder")}
      placeholder={t(lang, "search.placeholder")}
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
    />
    <button type="button" class="search-esc" data-search-close aria-label={t(lang, "search.close")}>esc</button>
  </div>
  <div class="search-body" tabindex="0">
    <p class="search-hint" data-search-hint>{strings.hint}</p>
    <ol class="search-results" id="search-results" role="listbox" aria-label={t(lang, "search.results")} data-search-results></ol>
  </div>
  <div class="search-foot">
    <span data-search-count aria-live="polite"></span>
    <span class="search-keys" aria-hidden="true">{t(lang, "search.keys")}</span>
  </div>
</dialog>

<script>
  import type { Lang } from "../../lib/paths";
  import { countLabel, inLang, isKind, type Kind } from "./results";

  interface Strings {
    hint: string;
    empty: string;
    unavailable: string;
    count1: string;
    countN: string;
    kinds: Record<Kind, string>;
  }
  interface Hit {
    url: string;
    excerpt: string;
    meta: Record<string, string | undefined>;
  }
  interface Pagefind {
    options: (o: Record<string, unknown>) => Promise<void>;
    search: (q: string) => Promise<{ results: { data: () => Promise<Hit> }[] } | null>;
  }

  const dlg = document.querySelector<HTMLDialogElement>("[data-search]");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const list = document.querySelector<HTMLOListElement>("[data-search-results]");
  const hint = document.querySelector<HTMLElement>("[data-search-hint]");
  const count = document.querySelector<HTMLElement>("[data-search-count]");

  if (dlg && input && list && hint && count) {
    const lang = (dlg.dataset.lang ?? "en") as Lang;
    const base = dlg.dataset.base ?? "/";
    const s = JSON.parse(dlg.dataset.strings ?? "{}") as Strings;

    let pf: Pagefind | null = null;
    let failed = false;
    const load = async (): Promise<Pagefind | null> => {
      if (pf || failed) return pf;
      try {
        pf = (await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`)) as Pagefind;
        await pf.options({ baseUrl: base, excerptLength: 22 });
      } catch {
        failed = true;
        pf = null;
      }
      return pf;
    };

    let hits: Hit[] = [];
    let sel = -1;
    const options = () => [...list.querySelectorAll<HTMLLIElement>("[role=option]")];

    const select = (n: number) => {
      const els = options();
      if (!els.length) return;
      sel = (n + els.length) % els.length;
      els.forEach((el, i) => {
        el.setAttribute("aria-selected", i === sel ? "true" : "false");
      });
      const cur = els[sel];
      if (cur) {
        input.setAttribute("aria-activedescendant", cur.id);
        cur.scrollIntoView({ block: "nearest" });
      }
    };

    const go = (el: HTMLElement | undefined) => {
      const href = el?.dataset.href;
      if (href) location.assign(href);
    };

    const chip = (h: Hit): HTMLElement => {
      const kind = isKind(h.meta.kind) ? h.meta.kind : "chapter";
      const span = document.createElement("span");
      span.className = "r-kind";
      span.dataset.kind = kind;
      const name = document.createElement("span");
      name.textContent = kind === "chapter" && h.meta.label ? h.meta.label : s.kinds[kind];
      span.append(name);
      if (h.meta.scale) {
        const sc = document.createElement("span");
        sc.className = "r-scale";
        sc.textContent = h.meta.scale;
        span.append(sc);
      }
      return span;
    };

    const render = () => {
      list.textContent = "";
      sel = -1;
      input.removeAttribute("aria-activedescendant");
      const q = input.value.trim();
      hint.hidden = q.length > 0 || failed;
      input.setAttribute("aria-expanded", hits.length > 0 ? "true" : "false");
      count.textContent = q && !failed ? countLabel(hits.length, s.count1, s.countN) : "";
      if (!q || failed) return;
      if (!hits.length) {
        const li = document.createElement("li");
        li.className = "search-none";
        li.textContent = s.empty;
        list.append(li);
        return;
      }
      hits.forEach((h, i) => {
        const li = document.createElement("li");
        li.id = `search-opt-${i}`;
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", "false");
        li.dataset.href = h.url;
        const body = document.createElement("span");
        body.className = "r-body";
        const title = document.createElement("span");
        title.className = "r-title";
        title.textContent = h.meta.title ?? h.url;
        const ex = document.createElement("span");
        ex.className = "r-excerpt";
        // Pagefind escapes the page text and adds only <mark>.
        ex.innerHTML = h.excerpt;
        body.append(title, ex);
        li.append(chip(h), body);
        li.addEventListener("mousemove", () => {
          if (sel !== i) select(i);
        });
        li.addEventListener("click", () => go(li));
        list.append(li);
      });
    };

    const showUnavailable = () => {
      hint.hidden = false;
      hint.textContent = s.unavailable;
    };

    const open = async () => {
      if (dlg.open) return;
      dlg.showModal();
      input.focus();
      input.select();
      if (!(await load())) showUnavailable();
    };
    const close = () => {
      if (dlg.open) dlg.close();
    };

    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-search-open]")) {
      b.addEventListener("click", open);
    }
    dlg.querySelector("[data-search-close]")?.addEventListener("click", close);
    // A click on the backdrop lands on the <dialog> element itself.
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) close();
    });

    window.addEventListener("keydown", (e) => {
      const k = e.key.toLowerCase();
      const typing = e.target instanceof HTMLElement && e.target.closest("input, textarea, select, [contenteditable]");
      if ((k === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !typing && !e.metaKey && !e.ctrlKey)) {
        e.preventDefault();
        void open();
      }
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        select(sel + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        select(sel - 1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        go(options()[Math.max(sel, 0)]);
      } else if (e.key === "Escape") {
        // type=search clears the field on the first Escape; close instead.
        e.preventDefault();
        close();
      }
    });

    let token = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const my = ++token;
        const q = input.value.trim();
        if (!q) {
          hits = [];
          render();
          return;
        }
        const engine = await load();
        if (!engine) {
          showUnavailable();
          return;
        }
        const res = await engine.search(q);
        const data = await Promise.all((res?.results ?? []).slice(0, 24).map((r) => r.data()));
        if (my !== token) return;
        hits = data.filter((d) => inLang(d.url, lang, base)).slice(0, 10);
        render();
      }, 130);
    });
  }
</script>

<style>
  .search {
    margin: 9vh auto auto;
    inline-size: min(44rem, calc(100vw - 2rem));
    max-inline-size: none;
    max-block-size: min(40rem, 80vh);
    padding: 0;
    border: 2px solid var(--ink);
    background: var(--sheet);
    color: var(--ink);
  }
  /* display only when open: a display rule on the base selector would beat the
     UA's dialog:not([open]) { display: none } and keep the closed dialog laid out. */
  .search[open] {
    display: flex;
    flex-direction: column;
  }
  .search::backdrop {
    background: rgb(16 18 20 / 0.55);
  }
  .search-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-block-end: 2px solid var(--ink);
  }
  .search-glass {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    flex: none;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 2;
  }
  .search-head input {
    flex: 1;
    min-inline-size: 0;
    font: inherit;
    font-size: 1.1875rem;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--ink);
  }
  .search-head input:focus {
    outline: none;
  }
  .search-head:focus-within {
    box-shadow: inset 0 -3px 0 var(--instruct);
  }
  .search-head input::-webkit-search-cancel-button {
    appearance: none;
  }
  .search-esc {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--ink-3);
    padding: 0.05rem 0.4rem;
    cursor: pointer;
  }
  .search-esc:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .search-body {
    overflow-y: auto;
    flex: 1;
    min-block-size: 0;
  }
  .search-body:focus-visible {
    outline-offset: -2px;
  }
  .search-hint {
    margin: 0;
    padding: 1.5rem 1rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Rows are built in script, so they carry no scoped-style attribute. */
  .search-results :global([role="option"]) {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-block-end: 1px solid var(--hair);
    cursor: pointer;
  }
  .search-results :global([role="option"][aria-selected="true"]) {
    background: var(--marker);
    box-shadow: inset 3px 0 0 var(--ink);
  }
  .search-results :global(.r-kind) {
    display: grid;
    gap: 0.1rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-3);
    line-height: 1.35;
  }
  .search-results :global(.r-scale) {
    font-family: var(--font-mono);
    font-weight: 400;
  }
  .search-results :global(.r-body) {
    display: grid;
    gap: 0.15rem;
    min-inline-size: 0;
  }
  .search-results :global(.r-title) {
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.35;
  }
  .search-results :global(.r-excerpt) {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-results :global(mark) {
    background: none;
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 -0.4em 0 var(--marker);
  }
  .search-results :global([aria-selected="true"] mark) {
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  .search-results :global(.search-none) {
    padding: 1.5rem 1rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .search-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.5rem 1rem;
    border-block-start: 1px solid var(--ink);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .search-keys {
    font-family: var(--font-mono);
  }
  @media (max-width: 30em) {
    .search {
      margin-block-start: 1rem;
    }
    .search-results :global([role="option"]) {
      grid-template-columns: minmax(0, 1fr);
    }
    .search-keys {
      display: none;
    }
  }
</style>
