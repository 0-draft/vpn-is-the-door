---
interface Props {
  n: number;
  title: string;
}

const { n, title } = Astro.props;
---

<li class="step" data-step={n} id={`step-${n}`}>
  <div class="step-card">
    <h3 class="step-h"><span class="step-n num" aria-hidden="true">{n}</span>{title}</h3>
    <slot />
  </div>
</li>

<style>
  .step-h {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin: 0 0 0.75rem;
  }
  .step-n {
    flex: none;
    display: inline-grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 1.5px solid var(--intruder);
    border-radius: 50%;
    color: var(--intruder-text);
    font-size: 0.9375rem;
    font-weight: 700;
    background: var(--sheet);
    transform: translateY(-0.1em);
  }
  .step :global(p:last-child) {
    margin-block-end: 0;
  }
</style>
