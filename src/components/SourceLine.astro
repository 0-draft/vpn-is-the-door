---
import { source } from "../data/sources";
import { t } from "../i18n/ui";
import type { Lang } from "../lib/paths";

interface Props {
  lang: Lang;
  ids: string[];
}

const { lang, ids } = Astro.props;
const items = ids.map((id) => source(id));

// Closed by default: one short line ("出典: 警察庁 ほか2件") instead of a paragraph of titles.
// Publisher names are cut at the first space ("CISA（米国）", not the full agency line).
const short = [...new Set(items.map((s) => s.publisher[lang].split(/\s/)[0] ?? s.publisher[lang]))];
const shown = short.slice(0, 1);
const rest = items.length - shown.length;
const more = rest > 0 ? (lang === "ja" ? ` ほか${rest}件` : ` +${rest}`) : "";
---

<details class="src">
  <summary>
    <span class="src-k">{t(lang, "source")}</span>
    <span class="src-who">{shown[0]}</span>
    {more && <span class="src-more">{more.trim()}</span>}
  </summary>
  <ul class="src-list">
    {
      items.map((s) => (
        <li>
          {s.publisher[lang]} <a href={s.url}>{lang === "ja" || /^[\x00-\x7F]*$/.test(s.title) ? s.title : `「${s.title}」`}</a>
          {s.locator && <span class="src-loc"> ({s.locator})</span>}
        </li>
      ))
    }
  </ul>
</details>

<style>
  .src {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .src summary {
    cursor: pointer;
    inline-size: fit-content;
    list-style: none;
    display: inline-flex;
    max-inline-size: 100%;
    gap: 0.4em;
    align-items: baseline;
  }
  .src summary::-webkit-details-marker {
    display: none;
  }
  .src summary::before {
    content: "";
    inline-size: 0.45em;
    block-size: 0.45em;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s var(--ease);
    align-self: center;
  }
  .src[open] summary::before {
    transform: rotate(45deg);
  }
  .src-k {
    color: var(--ink-2);
    font-weight: 700;
    white-space: nowrap;
  }
  .src-who {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .src-more {
    white-space: nowrap;
  }
  .src summary:hover .src-who {
    text-decoration: underline;
  }
  .src-list {
    margin: 0.4rem 0 0;
    padding-inline-start: 1.1em;
    font-size: 0.875rem;
  }
  .src-list li {
    margin-block: 0.2em;
  }
  .src-loc {
    font-variant-numeric: tabular-nums;
  }
</style>
