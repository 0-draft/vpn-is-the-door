---
// Fixed-field index of every case: organization / opening / date found / impact.
// Product, CVE and sources live on each case page. Japan first, then outside Japan.
import { type Case, ordered } from "../../data/cases";
import { type Lang, localePath } from "../../lib/paths";
import { openingName, openingTag } from "./labels";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ja = lang === "ja";
const base = import.meta.env.BASE_URL;
const all = ordered();
const groups: [string, Case[]][] = [
  [ja ? "日本" : "Japan", all.filter((c) => c.region === "jp")],
  [ja ? "海外" : "Outside Japan", all.filter((c) => c.region === "global")],
];
const head = ja ? ["組織", "侵入口", "判明日", "影響"] : ["Organization", "Way in", "Found", "Impact"];
---

<div class="table-scroll" tabindex="0" role="region" aria-label={ja ? "事例の一覧" : "Index of cases"}>
  <table class="ci">
    <thead>
      <tr>{head.map((h) => <th scope="col">{h}</th>)}</tr>
    </thead>
    {
      groups.map(([g, list]) => (
        <tbody>
          <tr class="ci-group">
            <th scope="rowgroup" colspan="4">{g}</th>
          </tr>
          {list.map((c) => {
            const tag = openingTag(lang, c.opening);
            return (
              <tr>
                <th scope="row" class="ci-org">
                  <a href={localePath(lang, `/cases/${c.slug}/`, base)}>{c.org[lang]}</a>
                  <span class="ci-sub">{c.sector[lang]}</span>
                  {c.kind === "not-ransomware" && <span class="ci-sub">{c.kindNote[lang]}</span>}
                </th>
                <td>
                  <span class={c.opening === "vpn" ? "ci-vpn" : undefined}>{openingName(lang, c)}</span>
                  {tag && (
                    <>
                      {" "}
                      <span class="tag-caution">{tag}</span>
                    </>
                  )}
                  {c.openingQualifier && <span class="ci-sub">{c.openingQualifier[lang]}</span>}
                </td>
                <td class="num ci-date" data-l={head[2]}>
                  {c.detected ?? c.disclosed}
                  {!c.detected && <span class="ci-sub">{ja ? "（公表日）" : "(disclosed)"}</span>}
                </td>
                <td data-l={head[3]}>{c.impactShort[lang]}</td>
              </tr>
            );
          })}
        </tbody>
      ))
    }
  </table>
</div>

<style>
  .ci {
    min-inline-size: 36rem;
    font-size: 0.9375rem;
  }
  .ci th[scope="col"] {
    white-space: nowrap;
  }
  .ci-group th {
    padding-block-start: 1.25rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    border-block-end: 1px solid var(--ink);
  }
  .ci-org {
    font-weight: 700;
    border-block-end: 1px solid var(--hair);
    inline-size: 15rem;
  }
  .ci-sub {
    display: block;
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .ci-vpn {
    font-weight: 700;
    color: var(--intruder-text);
  }
  .ci-date {
    white-space: nowrap;
    text-align: start;
  }
  /* phone: four columns cannot fit 390px; each case becomes a short labelled record */
  @media (max-width: 40rem) {
    .ci {
      min-inline-size: 0;
    }
    .ci thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .ci,
    .ci :is(tbody, tr, th, td) {
      display: block;
    }
    .ci tr:not(.ci-group) {
      padding-block: 0.75rem;
      border-block-end: 1px solid var(--hair);
    }
    .ci tr :is(th, td) {
      inline-size: auto;
      padding: 0;
      border: 0;
    }
    .ci tr:not(.ci-group) td {
      margin-block-start: 0.25rem;
    }
    .ci .ci-group th {
      padding-block: 1.25rem 0.4rem;
      border-block-end: 1px solid var(--ink);
    }
    .ci tr td[data-l] {
      padding-inline-start: 6.75rem;
    }
    .ci td[data-l]::before {
      content: attr(data-l);
      display: inline-block;
      inline-size: 6.75rem;
      margin-inline-start: -6.75rem;
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--ink-3);
    }
  }
</style>
