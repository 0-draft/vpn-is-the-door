---
// Fig. 4-1: one 1:500 block per case, Japan first. Only the opening that was used is drawn.
import { type Case, ordered } from "../../data/cases";
import { type Lang, localePath } from "../../lib/paths";
import CaseBlock from "./CaseBlock.astro";
import { openingName } from "./labels";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const all = ordered();
const groups: [string, Case[]][] = [
  [lang === "ja" ? "日本" : "Japan", all.filter((c) => c.region === "jp")],
  [lang === "ja" ? "海外" : "Outside Japan", all.filter((c) => c.region === "global")],
];
const year = (c: Case) => c.attacked.date.slice(0, 4);
---

<div class="cm">
  {
    groups.map(([g, list]) => (
      <section class="cm-group" aria-label={g}>
        <p class="cm-g">{g}</p>
        <ul class="cm-grid">
          {list.map((c) => (
            <li>
              <a href={localePath(lang, `/cases/${c.slug}/`, base)}>
                <CaseBlock lang={lang} c={c} uid={`m-${c.slug}`} label={`${c.short[lang]}: ${openingName(lang, c)}`} />
                <span class="cm-name">{c.short[lang]}</span>
                <span class="cm-meta num">
                  {year(c)} · {openingName(lang, c)}
                  {c.kind === "not-ransomware" && <span class="cm-kind">{lang === "ja" ? "ランサムウェアではない" : "not ransomware"}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .cm-group + .cm-group {
    margin-block-start: 1.5rem;
  }
  .cm-g {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink-2);
    border-block-end: 1px solid var(--hair);
  }
  .cm-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.25rem, 1fr));
    gap: 1.25rem 1rem;
  }
  .cm-grid a {
    display: grid;
    gap: 0.2rem;
    color: var(--ink);
    text-decoration: none;
  }
  .cm-grid a:hover .cm-name {
    text-decoration: underline;
  }
  .cm-name {
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--instruct);
  }
  .cm-meta {
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.4;
  }
  .cm-kind {
    display: block;
  }
</style>
