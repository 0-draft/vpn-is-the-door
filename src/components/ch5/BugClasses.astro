---
// Fig. 5-3: the KEV-listed VPN / remote-access CVEs as unit squares, one row per bug class.
import { byClass, CLASS_LABEL } from "../../lib/ch5-classes";
import type { Lang } from "../../lib/paths";

interface Props {
  lang: Lang;
  label: string;
}

const { lang, label } = Astro.props;
const groups = byClass();
const ROW = 62;
const PITCH = 20;
const h = groups.length * ROW + 4;
---

<svg class="dg bugclasses" viewBox={`0 0 400 ${h}`} role="img" aria-label={label}>
  {
    groups.map((g, gi) => {
      const y = gi * ROW + 20;
      return (
        <g>
          <text x="0" y={y} class:list={{ "bc-first": gi === 0 }}>
            {CLASS_LABEL[lang][g.cls]}
          </text>
          {g.cves.map((_, i) => (
            <rect class="unit" x={i * PITCH} y={y + 12} width="16" height="16" />
          ))}
          <text class="num bc-n" x={g.cves.length * PITCH + 6} y={y + 26}>
            {g.cves.length}
          </text>
        </g>
      );
    })
  }
</svg>

<style>
  .bugclasses {
    max-inline-size: 34rem;
  }
  .bugclasses text {
    font-size: 16px;
  }
  .bugclasses .bc-first {
    font-weight: 700;
  }
  .bugclasses .bc-n {
    font-family: var(--font-en);
    font-weight: 700;
  }
</style>
