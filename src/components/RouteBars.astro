---
// VPN share of known intrusion routes, one bar per year on a 0–100% track.
import { pct, ROUTE_YEARS, ROUTES_2026H1 } from "../data/stats";
import type { Lang } from "../lib/paths";

interface Props {
  lang: Lang;
  include2026?: boolean;
}

const { lang, include2026 = true } = Astro.props;
const rows = include2026 ? [...ROUTE_YEARS, ROUTES_2026H1] : ROUTE_YEARS;
const nLabel = (n: number) => (lang === "ja" ? `${n}件中` : `of ${n}`);
---

<ol class="bars" aria-hidden="true">
  {
    rows.map((y) => {
      const v = y.counts.vpn ?? 0;
      const p = pct(v, y.n);
      const partial = y === ROUTES_2026H1;
      return (
        <li class:list={["bar", { partial }]}>
          <span class="bar-y num">{y.label[lang]}</span>
          <span class="bar-track">
            <span class="bar-fill" style={`inline-size:${p}%`} />
            <span class="bar-50" />
          </span>
          <span class="bar-v num">
            <strong>{p}%</strong>{" "}
            <span class="bar-n">
              {v} {nLabel(y.n)}
            </span>
          </span>
        </li>
      );
    })
  }
</ol>

<style>
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 1rem;
  }
  .bar {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr) 9.5em;
    gap: 0.75rem;
    align-items: center;
  }
  .bar-y {
    color: var(--ink-2);
  }
  .bar-track {
    position: relative;
    block-size: 0.875rem;
    background: var(--room);
    border: 1px solid var(--line);
  }
  .bar-fill {
    position: absolute;
    inset-block: -1px;
    inset-inline-start: -1px;
    background: var(--intruder);
  }
  .partial .bar-fill {
    background: repeating-linear-gradient(45deg, var(--intruder) 0 2px, transparent 2px 6px);
    border: 1px solid var(--intruder);
  }
  .bar-50 {
    position: absolute;
    inset-block: -4px;
    inset-inline-start: 50%;
    border-inline-start: 1px dashed var(--ink-3);
  }
  .bar-v strong {
    font-weight: 700;
  }
  .bar-n {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  @media (max-width: 30em) {
    .bar {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "y v" "t t";
      row-gap: 0.25rem;
    }
    .bar-y {
      grid-area: y;
    }
    .bar-v {
      grid-area: v;
    }
    .bar-track {
      grid-area: t;
    }
  }
</style>
