---
// Days on one axis: how fast exploitation starts, the CISA deadline, and how
// long fixes actually take. Red = the intruder's clock; ink = the defenders'.
import type { Lang } from "../../lib/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ja = lang === "ja";
const MAX = 45;

const rows = [
  {
    days: 3,
    tone: "ink",
    label: ja
      ? "CISA の最短期限（米連邦機関、BOD 26-04）"
      : "CISA's shortest deadline (US federal agencies, BOD 26-04)",
  },
  {
    days: 5,
    tone: "hot",
    label: ja ? "公開から悪用までの平均（2023年、Mandiant）" : "Disclosure to exploitation, average (2023, Mandiant)",
  },
  {
    days: 32,
    tone: "mid",
    label: ja
      ? "エッジ機器の脆弱性の修正にかかった中央値（DBIR 2025）"
      : "Edge-device fixes, median time taken (DBIR 2025)",
  },
  {
    days: 43,
    tone: "mid",
    label: ja
      ? "KEV 掲載脆弱性の完全修正にかかった中央値（DBIR 2026）"
      : "KEV fixes, median time to full resolution (DBIR 2026)",
  },
] as const;
const unit = (d: number) => (ja ? `${d}日` : `${d} days`);
const ticks = [0, 10, 20, 30, 40];
---

<div class="pc" aria-hidden="true">
  <ol class="pc-rows">
    {
      rows.map((r) => (
        <li class={`pc-row pc-${r.tone}`}>
          <span class="pc-label">{r.label}</span>
          <span class="pc-track">
            <span class="pc-fill" style={`inline-size:${(r.days / MAX) * 100}%`} />
            <span class="pc-v num" style={`inset-inline-start:${(r.days / MAX) * 100}%`}>
              {unit(r.days)}
            </span>
          </span>
        </li>
      ))
    }
  </ol>
  <div class="pc-axis">
    {
      ticks.map((t) => (
        <span class="pc-tick num" style={`inset-inline-start:${(t / MAX) * 100}%`}>
          {t}
        </span>
      ))
    }
    <span class="pc-unit">{ja ? "日" : "days"}</span>
  </div>
</div>

<style>
  .pc {
    font-size: 1rem;
    line-height: 1.4;
    padding-inline-end: 5.5rem;
  }
  .pc-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .pc-row {
    display: grid;
    gap: 0.3rem;
  }
  .pc-label {
    color: var(--ink-2);
  }
  .pc-hot .pc-label {
    color: var(--intruder-text);
    font-weight: 700;
  }
  .pc-track {
    position: relative;
    block-size: 0.875rem;
    border-inline-start: 2px solid var(--ink);
  }
  .pc-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    background: var(--ink-2);
  }
  .pc-ink .pc-fill {
    background: var(--ink);
  }
  .pc-hot .pc-fill {
    background: var(--intruder);
  }
  .pc-v {
    position: absolute;
    inset-block-start: 50%;
    transform: translateY(-50%);
    padding-inline-start: 0.4rem;
    white-space: nowrap;
    font-weight: 700;
  }
  .pc-hot .pc-v {
    color: var(--intruder-text);
  }
  .pc-axis {
    position: relative;
    block-size: 1.5rem;
    margin-block-start: 0.5rem;
    border-block-start: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .pc-tick {
    position: absolute;
    inset-block-start: 0.15rem;
    transform: translateX(-50%);
  }
  .pc-tick:first-child {
    transform: none;
  }
  .pc-unit {
    position: absolute;
    inset-inline-start: 100%;
    padding-inline-start: 0.4rem;
    inset-block-start: 0.15rem;
  }
</style>
