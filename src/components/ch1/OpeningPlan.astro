---
// The tally plan with one opening (or the two remote-access openings) in focus.
// The other tallies are greyed so the reader sees which opening the section is about.
import type { Lang } from "../../lib/paths";
import FloorPlan from "../FloorPlan.astro";

interface Props {
  lang: Lang;
  focus: "vpn" | "rdp" | "mail" | "other" | "remote";
  uid: string;
  label: string;
}

const { lang, focus, uid, label } = Astro.props;
const tokens = focus === "remote" ? "vpn rdp" : focus;
---

<div class="op-plan" data-focus={tokens}>
  <FloorPlan lang={lang} mode="tally" uid={uid} label={label} />
</div>

<style is:global>
  .op-plan .tally {
    transition: opacity 160ms var(--ease);
  }
  .op-plan:not([data-focus~="vpn"]) .tally-vpn,
  .op-plan:not([data-focus~="rdp"]) .tally-rdp,
  .op-plan:not([data-focus~="mail"]) .tally-mail,
  .op-plan:not([data-focus~="other"]) .tally-other {
    opacity: 0.28;
  }
  /* a greyed VPN stack loses its red: red marks the opening under discussion only */
  .op-plan:not([data-focus~="vpn"]) .tally-vpn .unit.hot {
    fill: var(--ink-2);
  }
  .op-plan:not([data-focus~="vpn"]) .tally-vpn .hot-text {
    fill: var(--ink);
    font-weight: 400;
  }
  .op-plan[data-focus~="rdp"] .window[data-opening="rdp"] .glass,
  .op-plan[data-focus~="vpn"] .door[data-door="vpn"] .leaf,
  .op-plan[data-focus~="mail"] .door[data-door="main"] .leaf,
  .op-plan[data-focus~="other"] .door[data-door="loading"] .leaf {
    stroke-width: 3.5;
    stroke: var(--ink);
  }
  .op-plan[data-focus~="vpn"] .door[data-door="vpn"] .leaf {
    stroke: var(--intruder);
  }
  .op-plan[data-focus~="rdp"] .window[data-opening="rdp"] .glass {
    stroke-width: 2;
  }
  .op-plan[data-focus~="vpn"] .door[data-door="vpn"] .swing,
  .op-plan[data-focus~="mail"] .door[data-door="main"] .swing,
  .op-plan[data-focus~="other"] .door[data-door="loading"] .swing {
    stroke: var(--ink);
    stroke-width: 1.5;
  }
</style>
