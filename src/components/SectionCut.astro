---
// Where a page turns to engineering detail.
import { t } from "../i18n/ui";
import type { Lang } from "../lib/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="cut" role="separator" aria-label={t(lang, "cut.label")}>
  <p class="cut-label">{t(lang, "cut.label")}</p>
</div>

<style>
  .cut {
    margin-block: 4rem 1.5rem;
    border-block-start: 2px solid var(--ink);
    padding-block-start: 0.6rem;
  }
  .cut-label {
    margin: 0;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
</style>
