---
// Sticky floor plan + scrolling steps (design §4.2). The plan state follows the
// step crossing the middle of the viewport; scrolling back snaps, never replays.
import { figLabel } from "../i18n/ui";
import type { Lang } from "../lib/paths";
import FloorPlan from "./FloorPlan.astro";

interface Props {
  lang: Lang;
  n: string;
  caption: string;
}

const { lang, n, caption } = Astro.props;
---

<div class="scrolly" data-scrolly>
  <div class="scrolly-fig">
    <figure class="scrolly-sticky" id={`fig-${n}`} aria-labelledby={`fig-${n}-cap`}>
      <div class="scrolly-win">
        <FloorPlan lang={lang} mode="route" uid={`route-${n}`} doors="closed" label={caption} decorative />
      </div>
      <figcaption id={`fig-${n}-cap`}>
        <strong>{figLabel(lang, n)}</strong>
        <span class="scrolly-cap">{caption}</span>
        <span class="scrolly-tag">{lang === "ja" ? "複合事例（実在しない会社）" : "Composite scenario, fictional company"}</span>
      </figcaption>
    </figure>
  </div>
  <ol class="scrolly-steps">
    <slot />
  </ol>
</div>

<script>
  import { panOffset, STEP_FOCUS_TALL } from "../lib/plan";
  import { showFor, stepFromHash } from "../lib/steps";

  // Phones: the plan is drawn at full width inside a fixed window and panned to
  // the part the active step is about, so labels keep their size.
  const narrow = matchMedia("(max-width: 60em)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-scrolly]")) {
    const plan = root.querySelector<HTMLElement>(".plan");
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    if (!plan || steps.length === 0) continue;
    const win = root.querySelector<HTMLElement>(".scrolly-win");
    const tall = plan.querySelector<SVGSVGElement>(".plan-tall");
    let current = -1;
    const pan = () => {
      if (!win || !tall) return;
      if (!narrow.matches || getComputedStyle(tall).display === "none") {
        tall.style.removeProperty("--pan");
        return;
      }
      const vb = tall.viewBox.baseVal;
      const focus = STEP_FOCUS_TALL[Math.max(0, current)] ?? STEP_FOCUS_TALL[0]!;
      const px = panOffset(focus, [vb.y, vb.height], tall.getBoundingClientRect().height, win.clientHeight);
      tall.style.setProperty("--pan", `${-px}px`);
    };
    const set = (n: number) => {
      if (n === current) return;
      current = n;
      plan.dataset.show = showFor(n);
      for (const s of steps) s.toggleAttribute("data-active", Number(s.dataset.step) === n);
      pan();
    };
    addEventListener("resize", pan);
    narrow.addEventListener("change", pan);
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) set(Number((e.target as HTMLElement).dataset.step));
      },
      { rootMargin: "-62% 0px -34% 0px" },
    );
    for (const s of steps) io.observe(s);
    const fromHash = stepFromHash(location.hash);
    set(fromHash ?? 0);
  }
</script>

<style>
  .scrolly {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 2rem;
    margin-block: 2.5rem;
  }
  .scrolly-fig {
    grid-column: 2;
    grid-row: 1;
  }
  .scrolly-sticky {
    position: sticky;
    inset-block-start: 1rem;
    margin: 0;
    background: var(--sheet);
    border-block: 2px solid var(--ink);
    padding: 1rem;
  }
  .scrolly-sticky figcaption {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-2);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
  }
  .scrolly-tag {
    color: var(--ink-3);
    border: 1px solid var(--line);
    padding: 0 0.4em;
  }
  .scrolly-sticky :global(.plan-svg) {
    max-block-size: calc(100svh - 7rem);
    inline-size: auto;
    margin-inline: auto;
  }
  .scrolly-steps {
    grid-column: 1;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .scrolly-steps :global([data-step]) {
    min-block-size: 80svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 2rem;
  }
  .scrolly-steps :global([data-step]:first-child) {
    min-block-size: 60svh;
    justify-content: flex-start;
  }
  .scrolly-steps :global([data-step]:last-child) {
    min-block-size: 70svh;
  }
  .scrolly-steps :global(.step-card) {
    border-inline-start: 3px solid var(--hair);
    padding-inline-start: 1rem;
    transition: border-color 160ms var(--ease);
  }
  .scrolly-steps :global([data-active] .step-card) {
    border-inline-start-color: var(--intruder);
  }
  /* The plan's own breakpoint keys off its container; the sticky column is narrower than the page. */
  @media (max-width: 60em) {
    .scrolly {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .scrolly-fig,
    .scrolly-steps {
      grid-column: 1;
      grid-row: auto;
    }
    .scrolly-fig {
      position: sticky;
      inset-block-start: 0;
      z-index: 3;
      margin-inline: calc(-1 * var(--gutter));
      background: var(--sheet);
    }
    .scrolly-sticky {
      position: static;
      padding: 0;
      border-block-start: 0;
      display: flex;
      flex-direction: column;
      max-block-size: 62svh;
    }
    .scrolly-win {
      flex: 1 1 auto;
      min-block-size: 0;
      overflow: hidden;
    }
    .scrolly-sticky :global(.plan-svg) {
      max-block-size: none;
      inline-size: 100%;
      block-size: auto;
      transform: translateY(var(--pan, 0px));
      transition: transform 400ms var(--ease);
    }
    .scrolly-sticky figcaption {
      flex: none;
      margin: 0;
      padding: 0.3rem var(--gutter);
      border-block-start: 1px solid var(--hair);
      font-size: 0.875rem;
      line-height: 1.4;
    }
    .scrolly-sticky figcaption .scrolly-cap {
      display: none;
    }
    .scrolly-steps :global([data-step]) {
      justify-content: flex-end;
      padding-block-end: 12svh;
    }
    .scrolly-steps :global(.step-card) {
      position: relative;
      z-index: 1;
    }
  }
</style>
