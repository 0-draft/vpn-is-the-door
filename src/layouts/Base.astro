---
// Self-hosted fonts (design §6). Fontsource splits each family by unicode-range,
// so a page downloads only the subsets its text uses. BIZ UDPGothic is the
// exception: scripts/font-subset.ts cuts it to the site's own characters.
import "@fontsource/atkinson-hyperlegible-mono/400.css";
import "@fontsource/atkinson-hyperlegible-mono/600.css";
import "../styles/global.css";
import psLatinExt from "@fontsource-variable/public-sans/files/public-sans-latin-ext-wght-normal.woff2?url";
import psLatin from "@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url";
import { ogImagePath } from "../components/og/pages";
import { pageKind } from "../components/search/results";
import Search from "../components/search/Search.astro";
import { CHAPTERS } from "../data/chapters";
import { chapterLabel, SITE, t } from "../i18n/ui";
import { alternatePath, type Lang, localePath, stripBase, stripLocale } from "../lib/paths";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  chapter?: string;
  // false on pages with no twin in the other language (the bilingual 404)
  alternate?: boolean;
}

const { lang, title, description, chapter, alternate = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteTitle = t(lang, "site.title");
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const desc = description ?? t(lang, "site.desc");
const alt = alternatePath(Astro.url.pathname, base);
const enHref = alt.lang === "en" ? alt.href : Astro.url.pathname;
const jaHref = alt.lang === "ja" ? alt.href : Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = localePath(lang, "/", base);
const ogImage = new URL(ogImagePath(Astro.url.pathname, base), Astro.site);

// @fontsource-variable names the family "Public Sans Variable"; the site's stacks
// say "Public Sans", so declare the two subsets the pages use under that name.
const psRange = {
  latin:
    "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
  latinExt:
    "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF",
};
// One BIZ UDPGothic subset per language and weight; the build rewrites these
// placeholder URLs to the hashed files (scripts/font-subset.ts).
const bizFont = (w: 400 | 700) => `${base}__fonts/biz-udpgothic-${lang}-${w}.woff2`;
const fontFace = [
  ...[
    [psLatinExt, psRange.latinExt],
    [psLatin, psRange.latin],
  ].map(
    ([src, range]) =>
      `@font-face{font-family:"Public Sans";font-style:normal;font-display:swap;font-weight:100 900;src:url(${src}) format("woff2");unicode-range:${range}}`,
  ),
  ...([400, 700] as const).map(
    (w) =>
      `@font-face{font-family:"BIZ UDPGothic";font-style:normal;font-display:swap;font-weight:${w};src:url(${bizFont(w)}) format("woff2")}`,
  ),
].join("");

// Search index: the 404 page stays out; every other page indexes its <main>.
const local = stripLocale(stripBase(Astro.url.pathname, base));
const kind = pageKind(chapter, local);
const ch = CHAPTERS.find((c) => c.id === chapter);
// One key per element: Pagefind does not split "a:x, b:y" when a value holds a colon.
const pfMeta = [
  `kind:${kind}`,
  ch && kind === "chapter" ? `label:${chapterLabel(lang, ch.num)}` : "",
  ch && kind !== "case" ? `scale:${ch.scales.map((x) => `S=${x}`).join(" ")}` : "",
].filter(Boolean);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {alternate ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    {
      alternate && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
          <link rel="alternate" hreflang="ja" href={new URL(jaHref, Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(enHref, Astro.site)} />
        </>
      )
    }
    <meta property="og:type" content="article" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={fullTitle} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {lang === "en" && <link rel="preload" href={psLatin} as="font" type="font/woff2" crossorigin />}
    {lang === "ja" && <link rel="preload" href={bizFont(400)} as="font" type="font/woff2" crossorigin />}
    <style is:inline set:html={fontFace} />
    <script is:inline>
      // Apply stored theme / motion before first paint.
      try {
        const th = localStorage.getItem("theme");
        if (th === "light" || th === "dark") document.documentElement.dataset.theme = th;
        if (localStorage.getItem("motion") === "off") document.documentElement.dataset.motion = "off";
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, "nav.skip")}</a>
    <header class="masthead">
      <div class="bar">
        <a class="mark" href={home}>
          <span class="mark-title">{siteTitle}</span>
        </a>
        <p class="report mono">
          <span>{SITE.report}</span>
          <span>{t(lang, "site.rev")} {SITE.revision}</span>
          <time datetime={SITE.updated}>{SITE.updated}</time>
        </p>
        <div class="controls">
          <button type="button" class="ctl search-open" data-search-open aria-haspopup="dialog" aria-keyshortcuts="/ Control+K Meta+K">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"></circle><path d="M15 15 L21 21"></path></svg>
            <span>{t(lang, "search.open")}</span>
            <kbd aria-hidden="true">/</kbd>
          </button>
          <button type="button" class="ctl" data-theme-toggle>
            <span class="ctl-k">{t(lang, "nav.theme")}</span>{" "}
            <span data-theme-label data-auto={t(lang, "nav.themeAuto")} data-light={t(lang, "nav.themeLight")} data-dark={t(lang, "nav.themeDark")}
              >{t(lang, "nav.themeAuto")}</span
            >
          </button>
          <label class="ctl">
            <input type="checkbox" data-motion-toggle />
            <span>{t(lang, "nav.motion")}</span>
          </label>
          {
            alternate && (
              <a class="ctl lang" href={alt.href} hreflang={alt.lang} lang={alt.lang} aria-label={t(lang, "nav.langLabel")}>
                {t(lang, "nav.lang")}
              </a>
            )
          }
        </div>
      </div>
      <nav class="strip" aria-label={t(lang, "nav.chapters")}>
        <ol>
          <li>
            <a href={home} aria-current={chapter === "home" ? "page" : undefined}>
              <span class="strip-n">0</span>
              <span class="strip-t">{t(lang, "nav.home")}</span>
            </a>
          </li>
          {
            CHAPTERS.map((c) => (
              <li>
                <a
                  href={localePath(lang, c.path, base)}
                  aria-current={chapter === c.id ? "page" : undefined}
                  title={`${chapterLabel(lang, c.num)} ${c.title[lang]}`}
                >
                  <span class="strip-n">{c.num}</span>
                  <span class="strip-t">{c.short[lang]}</span>
                  <span class="strip-s mono">{c.scales.map((s) => `S=${s}`).join(" ")}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    <main id="main" tabindex="-1" data-pagefind-body={alternate ? "" : undefined}>
      {alternate && pfMeta.map((m) => <span data-pagefind-meta={m}></span>)}
      <slot />
    </main>
    <Search lang={lang} />

    <footer class="foot">
      <div class="foot-in">
        <p>{t(lang, "foot.method")}</p>
        <p>{t(lang, "foot.noaffil")}</p>
        <ul class="foot-links">
          <li><a href={localePath(lang, "/sources/", base)}>{t(lang, "nav.sources")}</a></li>
          <li><a href={localePath(lang, "/glossary/", base)}>{t(lang, "nav.glossary")}</a></li>
          <li><a href={SITE.repo}>{t(lang, "foot.source")}</a></li>
        </ul>
        <p class="mono foot-meta">
          {SITE.report} · {t(lang, "foot.revised")}{" "}
          <time datetime={SITE.updated}>{SITE.updated}</time> · {t(lang, "foot.license")}
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const order = ["auto", "light", "dark"] as const;
      const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const label = document.querySelector<HTMLElement>("[data-theme-label]");
      const show = () => {
        const cur = root.dataset.theme ?? "auto";
        if (label) label.textContent = label.dataset[cur] ?? cur;
      };
      show();
      btn?.addEventListener("click", () => {
        const cur = (root.dataset.theme ?? "auto") as (typeof order)[number];
        const next = order[(order.indexOf(cur) + 1) % order.length] ?? "auto";
        if (next === "auto") delete root.dataset.theme;
        else root.dataset.theme = next;
        try {
          if (next === "auto") localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
        } catch {}
        show();
      });

      const motion = document.querySelector<HTMLInputElement>("[data-motion-toggle]");
      if (motion) {
        motion.checked = root.dataset.motion === "off";
        motion.addEventListener("change", () => {
          if (motion.checked) root.dataset.motion = "off";
          else delete root.dataset.motion;
          try {
            localStorage.setItem("motion", motion.checked ? "off" : "on");
          } catch {}
        });
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: -3rem;
    background: var(--sheet);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }
  .skip:focus {
    inset-block-start: 0.5rem;
  }
  .masthead {
    background: var(--sheet);
    border-block-end: 2px solid var(--ink);
  }
  .bar {
    max-inline-size: var(--wide);
    margin-inline: auto;
    padding: 0.75rem var(--gutter) 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  .mark {
    color: var(--ink);
    text-decoration: none;
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: -0.005em;
  }
  .report {
    margin: 0;
    display: flex;
    gap: 0.75rem;
    color: var(--ink-3);
    font-size: 0.875rem;
    flex-wrap: wrap;
  }
  .controls {
    margin-inline-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    font-size: 0.875rem;
  }
  .ctl {
    font: inherit;
    font-size: 0.875rem;
    color: var(--ink-2);
    background: none;
    border: 0;
    padding: 0.25rem 0;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    cursor: pointer;
  }
  .ctl-k {
    color: var(--ink-3);
  }
  .ctl input {
    accent-color: var(--ink);
    inline-size: 1rem;
    block-size: 1rem;
    margin: 0;
  }
  .search-open {
    color: var(--ink);
    border: 1px solid var(--ink-3);
    padding: 0.2rem 0.4rem 0.2rem 0.5rem;
  }
  .search-open:hover {
    border-color: var(--ink);
    background: var(--marker);
  }
  .search-open svg {
    inline-size: 1rem;
    block-size: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
  }
  .search-open kbd {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink-3);
    border-inline-start: 1px solid var(--hair);
    padding-inline-start: 0.4rem;
  }
  .lang {
    color: var(--instruct);
    font-weight: 700;
  }
  .strip {
    max-inline-size: var(--wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
    overflow-x: auto;
  }
  .strip ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0;
    min-inline-size: max-content;
  }
  .strip a {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    column-gap: 0.4rem;
    padding: 0.5rem 1rem 0.55rem 0;
    margin-inline-end: 1rem;
    color: var(--ink-3);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.3;
    border-block-end: 3px solid transparent;
    margin-block-end: -2px;
  }
  .strip a:hover {
    color: var(--ink);
  }
  .strip a[aria-current="page"] {
    color: var(--ink);
    border-block-end-color: var(--ink);
    font-weight: 700;
  }
  .strip-n {
    font-family: var(--font-en);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    grid-row: span 2;
  }
  .strip-s {
    font-size: 0.75rem;
    grid-column: 2;
    color: var(--ink-3);
    font-weight: 400;
  }
  /* Scale tags under the strip are a nice-to-have; drop them on narrow screens. */
  @media (max-width: 45em) {
    .strip-s {
      display: none;
    }
    .report {
      display: none;
    }
    /* One fixed-height row: its height must not depend on which font has loaded,
       or the whole page shifts when the web fonts arrive (CLS on slow networks). */
    .controls {
      flex: 1 0 100%;
      margin-inline-start: 0;
      flex-wrap: nowrap;
      gap: 0 0.55rem;
      block-size: 2.25rem;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
    }
    .ctl {
      white-space: nowrap;
      flex: none;
    }
    /* room for the language link at 360px; the key hint is for keyboards */
    .search-open kbd {
      display: none;
    }
    .ctl {
      font-size: 0.8125rem;
    }
  }
  @media (max-width: 22.5em) {
    .ctl-k {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  main {
    outline: none;
  }
  .foot {
    margin-block-start: 6rem;
    border-block-start: 2px solid var(--ink);
    background: var(--sheet);
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .foot-in {
    max-inline-size: var(--wide);
    margin-inline: auto;
    padding: 2rem var(--gutter) 3rem;
  }
  .foot-in p {
    max-inline-size: var(--measure);
  }
  .foot-links {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .foot-meta {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
</style>
