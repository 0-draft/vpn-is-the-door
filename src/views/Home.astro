---
import Fig from "../components/Fig.astro";
import FloorPlan from "../components/FloorPlan.astro";
import RouteBars from "../components/RouteBars.astro";
import Summary from "../components/Summary.astro";
import { CHAPTERS } from "../data/chapters";
import { HEADLINE, latest, pct, ROUTE_YEARS, ROUTES_2026H1 } from "../data/stats";
import { chapterLabel } from "../i18n/ui";
import Base from "../layouts/Base.astro";
import { type Lang, localePath } from "../lib/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const y = latest();
const vpnPct = pct(y.counts.vpn ?? 0, y.n);
const ja = lang === "ja";
const href = (p: string) => localePath(lang, p, base);
const bf = HEADLINE.backupFail2025;

const copy = {
  kicker: ja ? "侵入事案調査報告書" : "Break-in investigation report",
  title: ja ? "扉はVPNだった" : "The door was the VPN",
  dek: ja
    ? "日本でランサムウェアの被害に遭い、侵入経路が判明した組織の3分の2は、VPN 機器から侵入されていた。社外から社内に入るために設けた扉が、そのまま侵入口になっている。"
    : "Of the Japanese ransomware victims that could say how the attacker got in, two thirds were entered through their VPN appliance. The door they installed so staff could work from outside became the way in.",
  heroNote: ja
    ? `侵入経路が判明した${y.n}件のうち${y.counts.vpn}件`
    : `${y.counts.vpn} of the ${y.n} cases with a known route`,
  figCaption: ja
    ? "港精密 本社の侵入口。四角1つが被害1件（2025年、侵入経路が判明した92件）"
    : "Minato Precision head office, points of entry. One square per case (2025, the 92 cases with a known route)",
  barsCaption: ja
    ? "侵入口に占める VPN 機器の割合（年別）"
    : "VPN appliances as a share of known entry points, by year",
  contents: ja ? "目次" : "Contents",
  read: ja ? "読む" : "Read",
  h1Note: ja
    ? "2026年上半期は回答が36件と少なく、メールの行がない。傾向の変化とは読まないこと。"
    : "2026 H1 has only 36 answers and no email row in NPA's table. Do not read it as a change in trend.",
};
---

<Base lang={lang} chapter="home">
  <article class="home">
    <header class="cover">
      <p class="kicker">{copy.kicker}</p>
      <h1>{copy.title}</h1>
      <p class="dek">{copy.dek}</p>
    </header>

    <Summary lang={lang}>
      {
        ja ? (
          <ol>
            <li>
              2025年、侵入経路が判明したランサムウェア被害92件のうち61件（66.3%）が VPN 機器からの侵入だった。不審メールは2件。
            </li>
            <li>VPN 機器は、社員が受付を通らずに外から入れるように外壁に付けた扉にあたる。インターネット上の誰でもこの扉の前に立てる。</li>
            <li>扉の機器そのものに欠陥があると、ログインの前に破られる。パスワードも多要素認証も確かめられないまま通過される。</li>
            <li>
              侵入者は社内の鍵（Active Directory）を奪い、バックアップを消し、データを持ち出し、最後に暗号化する。2025年、バックアップから復元を試みた{bf.n}件のうち{bf.failed}件が元に戻せなかった。
            </li>
            <li>
              経営が決めることは3つ。自社の扉をすべて把握して担当者を決める。パッチの期限を「日」で決め、パスワードの再設定まで含める。侵入者が届かないバックアップを持つ。
            </li>
          </ol>
        ) : (
          <ol>
            <li>
              In 2025, 61 of the 92 Japanese ransomware victims that could say how the attacker got in named their VPN appliance (66.3%). Email accounted for two.
            </li>
            <li>A VPN appliance is a door in the outer wall that lets staff in without passing reception. Anyone on the internet can walk up to it.</li>
            <li>If the appliance itself has a flaw, it can be broken before anyone logs in. The password and multi-factor authentication (MFA) are never checked.</li>
            <li>
              Once inside, intruders take the master keys (Active Directory), delete the backups, copy data out and encrypt last. In 2025, {bf.failed} of {bf.n} victims that tried to restore from backup could not.
            </li>
            <li>
              Three decisions belong to leadership: know every door you own and who looks after it; set a patch deadline in days that includes resetting passwords; keep a backup the intruder cannot reach.
            </li>
          </ol>
        )
      }
    </Summary>

    <section class="hero" aria-labelledby="hero-h">
      <h2 id="hero-h" class="visually-hidden">{ja ? "侵入口図" : "Point-of-entry plan"}</h2>
      <div class="hero-num">
        <p class="numeral num" aria-hidden="true">{vpnPct}<span class="pct">%</span></p>
        <p class="numeral-note">
          <strong>{ja ? "VPN 機器" : "VPN appliance"}</strong>
          <span>{copy.heroNote}</span>
        </p>
      </div>
      <Fig lang={lang} n="0-1" caption={copy.figCaption} sources={[y.source]} composite nts wide>
        <FloorPlan lang={lang} mode="tally" uid="hero" label={copy.figCaption} />
        <table slot="data">
          <thead>
            <tr>
              <th>{ja ? "侵入経路" : "Route"}</th>
              <th class="num">{ja ? "件数" : "Cases"}</th>
              <th class="num">%</th>
            </tr>
          </thead>
          <tbody>
            {
              (
                [
                  ["vpn", ja ? "VPN 機器" : "VPN appliance"],
                  ["rdp", ja ? "リモートデスクトップ" : "Remote desktop"],
                  ["other", ja ? "その他" : "Other"],
                  ["mail", ja ? "不審メールやその添付ファイル" : "Suspicious email or attachments"],
                ] as const
              ).map(([k, name]) => (
                <tr>
                  <td>{name}</td>
                  <td class="num">{y.counts[k]}</td>
                  <td class="num">{pct(y.counts[k] ?? 0, y.n)}</td>
                </tr>
              ))
            }
            <tr>
              <th scope="row">{ja ? "計" : "Total"}</th>
              <td class="num">{y.n}</td>
              <td class="num">100</td>
            </tr>
          </tbody>
        </table>
      </Fig>
    </section>

    <Fig
      lang={lang}
      n="0-2"
      caption={copy.barsCaption}
      sources={[...new Set([...ROUTE_YEARS.map((r) => r.source), ROUTES_2026H1.source])]}
    >
      <RouteBars lang={lang} />
      <p class="bars-note">{copy.h1Note}</p>
      <table slot="data">
        <thead>
          <tr>
            <th>{ja ? "年" : "Year"}</th>
            <th class="num">{ja ? "VPN 機器" : "VPN"}</th>
            <th class="num">{ja ? "有効回答" : "Answers"}</th>
            <th class="num">%</th>
          </tr>
        </thead>
        <tbody>
          {
            [...ROUTE_YEARS, ROUTES_2026H1].map((r) => (
              <tr>
                <td>{r.label[lang]}</td>
                <td class="num">{r.counts.vpn}</td>
                <td class="num">{r.n}</td>
                <td class="num">{pct(r.counts.vpn ?? 0, r.n)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </Fig>

    <nav class="toc" aria-labelledby="toc-h">
      <h2 id="toc-h">{copy.contents}</h2>
      <ol>
        {
          CHAPTERS.map((c) => (
            <li>
              <a href={href(c.path)}>
                <span class="toc-n num">{chapterLabel(lang, c.num)}</span>
                <span class="toc-t">{c.title[lang]}</span>
                <span class="toc-dots" aria-hidden="true" />
                <span class="toc-s mono">{c.scales.map((s) => `S=${s}`).join(" ")}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </article>
</Base>

<style>
  .home {
    max-inline-size: var(--wide);
    margin-inline: auto;
    padding: 2.5rem var(--gutter) 0;
  }
  .cover {
    max-inline-size: 52rem;
  }
  .kicker {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }
  .cover h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.25rem);
    line-height: 1.05;
  }
  :global(:lang(ja)) .cover h1 {
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 3.75rem);
    line-height: 1.25;
  }
  .dek {
    margin-block: 1.25rem 0;
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-inline-size: 44rem;
  }
  :global(:lang(ja)) .dek {
    font-size: 1.1875rem;
    line-height: 1.75;
  }
  .hero {
    margin-block-start: 3rem;
  }
  .hero-num {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.5rem 1.5rem;
  }
  .numeral {
    margin: 0;
    font-family: var(--font-en);
    font-weight: 800;
    font-size: clamp(4.5rem, 14vw, 10.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--intruder-text);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .pct {
    font-size: 0.55em;
    margin-inline-start: 0.04em;
  }
  .numeral-note {
    margin: 0 0 0.6rem;
    display: grid;
    gap: 0.1rem;
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .numeral-note span {
    color: var(--ink-2);
  }
  .bars-note {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink-3);
    max-inline-size: var(--measure);
  }
  .toc {
    margin-block-start: 4rem;
    max-inline-size: 52rem;
  }
  .toc h2 {
    margin-block-end: 1rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: 2px solid var(--ink);
  }
  .toc a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-block-end: 1px solid var(--hair);
    color: var(--ink);
    text-decoration: none;
  }
  .toc a:hover .toc-t {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .toc-n {
    flex: 0 0 6.5em;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }
  :global(:lang(ja)) .toc-n {
    flex-basis: 3.5em;
  }
  .toc-t {
    font-weight: 700;
    font-size: 1.1875rem;
  }
  .toc-dots {
    flex: 1 1 2rem;
    border-block-end: 1px dotted var(--line);
    transform: translateY(-0.3em);
    min-inline-size: 1rem;
  }
  .toc-s {
    color: var(--ink-3);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  @media (max-width: 40em) {
    .toc a {
      flex-wrap: wrap;
    }
    .toc-dots {
      display: none;
    }
    .toc-s {
      flex-basis: 100%;
      padding-inline-start: 0;
    }
    .toc-n {
      flex-basis: auto;
    }
  }
</style>
