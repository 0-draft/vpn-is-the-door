{
  "name": "vpn-is-the-door",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist --exclude-selectors \".scale, .ch-kicker, .ch-nav, svg, thead, .fig-tags, .cut-a\"",
    "preview": "node scripts/serve.ts",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "markdownlint-cli2",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:data": "node scripts/validate-data.ts",
    "perf": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/biz-udpgothic": "5.3.0",
    "astro": "^7.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@expo-google-fonts/biz-udpgothic": "0.4.2",
    "@fontsource/public-sans": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-launcher": "1.2.1",
    "fontverter": "2.0.0",
    "lighthouse": "13.5.0",
    "markdownlint-cli2": "^0.24.0",
    "pagefind": "1.5.2",
    "satori": "0.33.5",
    "subset-font": "2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
